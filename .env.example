# Itarang IoT Stack — env vars consumed by docker-compose.yml.
# Copy this to `.env` (NEVER commit .env), fill in values, restart stack.
#
# This file documents the SHAPE only. The real .env on the VPS is written
# from GitHub Secret IOT_ENV_FILE_B64 by the deploy workflow.

# ─── Postgres (TimescaleDB) ─────────────────────────────────────────────────
PG_PASSWORD=change-me-to-a-long-random-string
PG_DSN_HOST=postgresql://intellicar:<PG_PASSWORD>@127.0.0.1:5433/intellicar
DASHBOARD_RO_PASSWORD=change-me-to-a-long-random-string
WORKER_ID=0
WORKER_COUNT=1

# ─── Intellicar API credentials (poller + fetch_intellicar.py) ──────────────
INTELLICAR_USERNAME=
INTELLICAR_PASSWORD=

# ─── AWS RDS DSN for the NBFC source-of-truth DB (aggregator reads here) ───
# Use a READ-ONLY user — the aggregator never writes to RDS.
# Format: postgresql://user:pass@host:port/db?sslmode=require
NBFC_RDS_DSN_RO=

# ─── AWS migration: the IoT DB itself moves to RDS for plain Postgres 16 ─────
# Post-migration, the aggregator's IOT_PG_DSN and the poller's PG_DSN point at
# the new IoT RDS instance (NOT the local Timescale container). Both should
# include ?sslmode=require so the connection is encrypted to RDS, e.g.:
#   IOT_PG_DSN=postgresql://itarang_admin:<pw>@itarang-iot-db.xxxx.rds.amazonaws.com:5432/itarang?sslmode=require
# Until cutover these stay pointed at the local container (see docker-compose.yml).

# ─── Aggregator job intervals (seconds) — optional; code defaults shown ──────
# Refresh jobs replace the old Timescale continuous-aggregate policies.
INTERVAL_REFRESH_DAILY_DISTANCE=1800   # 30 min (old daily_distance policy)
INTERVAL_REFRESH_HOURLY_BATTERY=900    # 15 min (old hourly_battery policy)
INTERVAL_COLD_ARCHIVE=86400            # daily — see below

# ─── Cold-archive job (jobs/cold_archive_partitions.py) ─────────────────────
# Exports each pg_partman partition to S3 BEFORE retention drops it (Timescale
# compression no longer exists on RDS — without this, dropped data is gone).
# Bucket is REQUIRED for the job to do anything; if unset the job no-ops.
IOT_ARCHIVE_S3_BUCKET=itarang-iot-archive
IOT_ARCHIVE_S3_PREFIX=partitions
# Days before the retention drop to archive. Keep > pg_partman_bgw.interval
# (≈ hourly) so the export always wins the race against the drop.
IOT_ARCHIVE_LEAD_DAYS=3
# Optional per-table retention override (JSON). Empty => use partman.part_config
# (the authoritative retention set in schema_rds.sql).
#   IOT_ARCHIVE_RETENTION_JSON={"telemetry_gps":"90 days"}
IOT_ARCHIVE_RETENTION_JSON=
# AWS creds for boto3: in prod these come from the Fargate task IAM role (DO NOT
# put keys here). For local runs, use the standard AWS_* env vars / ~/.aws.
# AWS_REGION=ap-south-1

# ─── Monitor page basic-auth (HTML status dashboard at iot-status.itarang.com) ─
MONITOR_USER=admin
MONITOR_PASS=change-me-to-a-long-random-string
