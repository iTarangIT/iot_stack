# Itarang IoT Stack — env vars consumed by docker-compose.yml.
# Copy this to `.env` (NEVER commit .env), fill in values, restart stack.
#
# This file documents the SHAPE only. The real .env on the VPS is written
# from GitHub Secret IOT_ENV_FILE_B64 by the deploy workflow.

# ─── Postgres (TimescaleDB) ─────────────────────────────────────────────────
PG_PASSWORD=change-me-to-a-long-random-string
PG_DSN_HOST=postgresql://intellicar:<PG_PASSWORD>@127.0.0.1:5433/intellicar
DASHBOARD_RO_PASSWORD=change-me-to-a-long-random-string
WORKER_ID=0
WORKER_COUNT=1

# ─── Intellicar API credentials (poller + fetch_intellicar.py) ──────────────
INTELLICAR_USERNAME=
INTELLICAR_PASSWORD=

# ─── AWS RDS DSN for the NBFC source-of-truth DB (aggregator reads here) ───
# Use a READ-ONLY user — the aggregator never writes to RDS.
# Format: postgresql://user:pass@host:port/db?sslmode=require
NBFC_RDS_DSN_RO=

# ─── Monitor page basic-auth (HTML status dashboard at iot-status.itarang.com) ─
MONITOR_USER=admin
MONITOR_PASS=change-me-to-a-long-random-string
